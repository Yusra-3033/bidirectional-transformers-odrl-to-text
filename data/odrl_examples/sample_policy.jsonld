{
  "@context": "http://www.w3.org/ns/odrl.jsonld",
  "@type": "Policy",
  "permission": [
    {
      "target": "http://example.com/content/video1",
      "action": "play",
      "assignee": "http://example.com/user/UserA",
      "assigner": "http://example.com/org/ProviderX",
      "constraint": {
        "leftOperand": "purpose",
        "operator": "eq",
        "rightOperand": "non-commercial"
      }
    }
  ]
}
