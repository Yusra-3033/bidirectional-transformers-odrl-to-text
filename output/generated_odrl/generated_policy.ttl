@prefix odrl: <http://www.w3.org/ns/odrl/2/> .
@prefix dc: <http://purl.org/dc/terms/> .

<> a odrl:Policy ;
    odrl:assigner <https://example.com/user/a> ;
    odrl:assignee <https://example.com/user/a> ;
    odrl:permission [
        a odrl:Permission ;
        odrl:action odrl:play ;
        odrl:target <https://example.com/video1> ;
        odrl:constraint [
            a odrl:Constraint ;
            odrl:operator odrl:eq ;
            odrl:rights odrl:nonCommercial
        ]
    ] .