@prefix odrl: <http://www.w3.org/ns/odrl/2/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.com/policy/n160916ccc1ad443aa55b0fce66c85edfb2>
    a odrl:Policy ;
    odrl:permission [
        odrl:action odrl:play ;
        odrl:target <http://example.com/content/video1> ;
        odrl:assignee <http://example.com/user/UserA> ;
        odrl:assigner <http://example.com/org/ProviderX> ;
        odrl:constraint [
            odrl:leftOperand odrl:purpose ;
            odrl:operator odrl:eq ;
            odrl:rightOperand "non-commercial"
        ]
    ] .