{
  "@context": "https://www.w3.org/ns/odrl.jsonld",
  "@graph": [
    {
      "@id": "_:policy",
      "@type": "odrl:Policy",
      "odrl:assigner": {
        "@id": "_:userA"
      },
      "odrl:assignee": {
        "@id": "_:userA"
      },
      "odrl:permission": [
        {
          "@id": "_:permission1",
          "@type": "odrl:Permission",
          "odrl:action": {
            "@id": "odrl:play"
          },
          "odrl:target": {
            "@id": "video1"
          },
          "odrl:constraint": [
            {
              "@id": "_:constraint1",
              "@type": "odrl:Constraint",
              "odrl:name": "odrl:usage",
              "odrl:value": "non-commercial"
            }
          ]
        }
      ]
    },
    {
      "@id": "_:userA",
      "@type": "odrl:Party",
      "odrl:label": "User A"
    },
    {
      "@id": "video1",
      "@type": "odrl:Asset",
      "odrl:label": "Video 1"
    }
  ]
}